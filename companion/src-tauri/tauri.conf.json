{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MLJ Companion",
  "version": "2.0.0",
  "identifier": "com.samxop123.companion",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Minecraft Life Journal Companion",
        "width": 720,
        "height": 820,
        "minWidth": 640,
        "minHeight": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "SamXop123",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
